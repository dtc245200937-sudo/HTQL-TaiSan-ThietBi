<!-- Central Service Access Portal -->
<div class="section-card" style="margin-bottom: 2rem; background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(79, 70, 229, 0.2)); border: 1px solid rgba(129, 140, 248, 0.3);">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.3rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-globe" style="color: #818cf8;"></i> Cổng Truy Cập Tất Cả Dịch Vụ (Central DevOps Portal)
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
        Truy cập nhanh tất cả công cụ quản lý, CSDL và hệ thống giám sát qua 1 giao diện duy nhất.
      </p>
    </div>
    <span class="badge badge-success" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
      <i class="fa-solid fa-check-double"></i> Nginx SSL Proxy Active
    </span>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
    <a href="/assets" class="btn" style="background: rgba(79, 70, 229, 0.2); border: 1px solid rgba(79, 70, 229, 0.4); color: #818cf8; justify-content: center; padding: 0.8rem;">
      <i class="fa-solid fa-laptop-code"></i> Quản Lý Tài Sản
    </a>
    <a href="/pgadmin/" target="_blank" class="btn" style="background: rgba(59, 130, 246, 0.2); border: 1px solid rgba(59, 130, 246, 0.4); color: #60a5fa; justify-content: center; padding: 0.8rem;">
      <i class="fa-solid fa-database"></i> pgAdmin (DB Tool)
    </a>
    <a href="/grafana/" target="_blank" class="btn" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.4); color: #fbbf24; justify-content: center; padding: 0.8rem;">
      <i class="fa-solid fa-chart-line"></i> Grafana & Loki Logs
    </a>
    <a href="http://localhost:9090" target="_blank" class="btn" style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; justify-content: center; padding: 0.8rem;">
      <i class="fa-solid fa-fire"></i> Prometheus Server
    </a>
    <a href="/health" target="_blank" class="btn" style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; justify-content: center; padding: 0.8rem;">
      <i class="fa-solid fa-heart-pulse"></i> Health Check
    </a>
  </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-info">
      <h3>Tổng Số Tài Sản</h3>
      <p><%= stats.totalAssets %></p>
    </div>
    <div class="stat-icon icon-blue">
      <i class="fa-solid fa-server"></i>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <h3>Đang Hoạt Động</h3>
      <p><%= stats.statusMap['Hoạt động'] || 0 %></p>
    </div>
    <div class="stat-icon icon-green">
      <i class="fa-solid fa-circle-check"></i>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <h3>Đang Bảo Trì</h3>
      <p><%= stats.statusMap['Đang bảo trì'] || 0 %></p>
    </div>
    <div class="stat-icon icon-amber">
      <i class="fa-solid fa-wrench"></i>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <h3>Tổng Chi Phí Bảo Trì</h3>
      <p><%= (stats.totalMaintCost).toLocaleString('vi-VN') %> ₫</p>
    </div>
    <div class="stat-icon icon-purple">
      <i class="fa-solid fa-coins"></i>
    </div>
  </div>
</div>

<!-- Main Dashboard Grid -->
<div class="grid-2">
  <!-- Recent Assets -->
  <div class="section-card">
    <div class="section-header">
      <h2><i class="fa-solid fa-clock-rotate-left"></i> Tài Sản Mới Thêm</h2>
      <a href="/assets" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">Xem Tất Cả</a>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Mã TS</th>
            <th>Tên Tài Sản</th>
            <th>Danh Mục</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentAssets.length === 0) { %>
            <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">Chưa có tài sản</td></tr>
          <% } else { %>
            <% recentAssets.forEach(a => { %>
              <tr>
                <td><strong><%= a.asset_code %></strong></td>
                <td><%= a.name %></td>
                <td><span class="badge badge-secondary"><%= a.category_name || 'Khác' %></span></td>
                <td>
                  <span class="badge <%= a.status === 'Hoạt động' ? 'badge-success' : (a.status === 'Đang bảo trì' ? 'badge-warning' : 'badge-danger') %>">
                    <%= a.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Maintenance Logs -->
  <div class="section-card">
    <div class="section-header">
      <h2><i class="fa-solid fa-screwdriver-wrench"></i> Nhật Ký Bảo Trì Gần Đây</h2>
      <a href="/maintenance" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">Xem Chi Tiết</a>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Mã TS</th>
            <th>Loại Bảo Trì</th>
            <th>Chi Phí</th>
            <th>Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentMaintenance.length === 0) { %>
            <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">Chưa có lịch sử bảo trì</td></tr>
          <% } else { %>
            <% recentMaintenance.forEach(m => { %>
              <tr>
                <td><strong><%= m.asset_code %></strong></td>
                <td><%= m.maintenance_type %></td>
                <td><%= (parseFloat(m.cost)).toLocaleString('vi-VN') %> ₫</td>
                <td>
                  <span class="badge <%= m.result === 'Hoàn thành' ? 'badge-success' : 'badge-warning' %>">
                    <%= m.result %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('footer') %>
